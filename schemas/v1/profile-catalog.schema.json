{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tanchouteur/CliOS/schemas/v1/profile-catalog.schema.json",
  "title": "CliOS vehicle profile catalog v1",
  "type": "object",
  "required": ["schema_version", "active_profile", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "active_profile": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "profiles": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]+$"},
      "additionalProperties": {
        "type": "object", "required": ["name", "can_file", "config_file", "save_file"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "can_file": {"$ref": "#/$defs/jsonFilename"},
          "config_file": {"$ref": "#/$defs/jsonFilename"},
          "save_file": {"$ref": "#/$defs/jsonFilename"}
        }
      }
    }
  },
  "$defs": {
    "jsonFilename": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"}
  }
}
