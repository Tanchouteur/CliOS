{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tanchouteur/CliOS/schemas/v1/release-manifest.schema.json",
  "title": "CliOS release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "channel", "platform", "archive_url", "archive_sha256", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
    "channel": {"enum": ["stable", "beta"]},
    "platform": {"const": "raspberry-pi-os-bookworm-arm64"},
    "archive_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
    }
  }
}
