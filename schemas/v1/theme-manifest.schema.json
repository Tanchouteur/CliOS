{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tanchouteur/CliOS/schemas/v1/theme-manifest.schema.json",
  "title": "CliOS Theme API v1 manifest",
  "type": "object",
  "required": ["apiVersion", "id", "label", "dashboard", "minCliOSVersion", "supportedResolutions", "capabilities", "palette"],
  "properties": {
    "apiVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "order": {"type": "number"},
    "dashboard": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.-]*\\.qml$"},
    "minCliOSVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "supportedResolutions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"}, "contains": {"const": "1920x720"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "palette": {
      "type": "object",
      "required": ["background", "surface", "surfaceRaised", "surfaceSoft", "text", "textSecondary", "outline", "gaugeTrack"],
      "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    }
  }
}
