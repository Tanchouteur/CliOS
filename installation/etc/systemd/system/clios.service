[Unit]
Description=CliOS 2 Automotive Dashboard
After=graphical.target sound.target can0.service systemd-user-sessions.service
Wants=can0.service

[Service]
Type=simple
User=clios
PAMName=login
WorkingDirectory=/opt/clios/current
Environment=QT_QPA_PLATFORM=wayland
ExecStart=/usr/bin/cage -s -- /usr/bin/python3 -u /opt/clios/current/tools/clios_launcher.py -- --ui gui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
